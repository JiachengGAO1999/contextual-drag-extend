\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Accuracy change from late access blocking. Points show \textup  {LateBlock}{} minus \textup  {Full}{} accuracy in percentage points for the indicated history type. Bars are 95\% percentile bootstrap intervals over questions, keeping the two seeds together. Qwen3-8B covers 23 Game24 questions. The other targets cover a shared 15-question subset, and the correct-history control covers eight questions. Each MATH row has eight questions and the Qwen3-8B target, with Qwen3-1.7B and Qwen3-4B source drafts for MATH500 and MATH-train, respectively. These rows are not a matched failed-versus-correct interaction. That comparison uses the same eight questions in Section~\ref {sec:specificity}. Unresolved scores count as incorrect.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:access-effects}{{2}{6}{Accuracy change from late access blocking. Points show \lateblock {} minus \fullaccess {} accuracy in percentage points for the indicated history type. Bars are 95\% percentile bootstrap intervals over questions, keeping the two seeds together. Qwen3-8B covers 23 Game24 questions. The other targets cover a shared 15-question subset, and the correct-history control covers eight questions. Each MATH row has eight questions and the Qwen3-8B target, with Qwen3-1.7B and Qwen3-4B source drafts for MATH500 and MATH-train, respectively. These rows are not a matched failed-versus-correct interaction. That comparison uses the same eight questions in Section~\ref {sec:specificity}. Unresolved scores count as incorrect}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}The direction also appears in longer-form mathematical reasoning}{6}{subsection.3.5}\protected@file@percent }
